node_modules/
dist/
.DS_Store
assets/source/**/*.fbx
assets/source/**/*.zip

# Mixamo motion for the 3D units, generated locally by
# tools/render/export_units.sh from the FBX files above. Adobe's terms
# allow the motion in a project, not as data handed on -- so it is never
# committed, the same way the FBX files are not. A clone without it draws
# the units as sprites. The 0 A.D. motion under units/0ad/ is CC BY-SA
# and IS committed, with its licence.
public/assets/units/*.anim.bin
tools/render/_tmp/
__pycache__/

# FUSE leaves one of these behind for every file deleted while something still
# holds it open, which on this share is every file a render replaces. They are
# the old contents of a file that no longer exists and they clean themselves up
# when the handle closes; they are never ours to commit.
.fuse_hidden*
tools/render/_tmp/

# Screenshots of the original Stronghold Crusader, kept locally as visual
# reference. Firefly Studios' copyright -- not ours to redistribute, and 57 MB
# of material nobody cloning this needs.
reference/

# Saves and accounts of a `docker compose up` run from the repository root.
/data/
tests/.build/
